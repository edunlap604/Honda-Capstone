#!/usr/bin/env python3
"""Convert a CSV file into SQL Server CREATE TABLE and INSERT statements."""

import argparse
import csv
import os
import sys
import tempfile
from pathlib import Path
from typing import TextIO


def quote_identifier(identifier: str) -> str:
    return "[" + identifier.replace("]", "]]") + "]"


def quote_table_name(table_name: str, schema_qualified: bool = True) -> str:
    parts = table_name.split(".") if schema_qualified else [table_name]
    if any(not part for part in parts):
        raise ValueError("table names cannot contain empty dot-separated parts")
    return ".".join(quote_identifier(part) for part in parts)


def sql_string(value: str) -> str:
    return "N'" + value.replace("'", "''") + "'"


def read_header(reader: csv.reader) -> list[str]:
    try:
        headers = next(reader)
    except StopIteration as error:
        raise ValueError("the CSV file is empty") from error

    if not headers or any(not header.strip() for header in headers):
        raise ValueError("the CSV file must have non-empty column names")
    if len({header.casefold() for header in headers}) != len(headers):
        raise ValueError("the CSV file must have unique column names")
    return headers


def validate_csv(input_path: Path, delimiter: str) -> None:
    with input_path.open("r", encoding="utf-8-sig", newline="") as source:
        reader = csv.reader(source, delimiter=delimiter, strict=True)
        headers = read_header(reader)
        for record_number, row in enumerate(reader, start=2):
            if row and len(row) != len(headers):
                raise ValueError(
                    f"record {record_number} has {len(row)} fields; expected {len(headers)}"
                )


def write_sql(
    input_path: Path,
    table_name: str,
    output: TextIO,
    delimiter: str,
    schema_qualified: bool,
) -> None:
    with input_path.open("r", encoding="utf-8-sig", newline="") as source:
        reader = csv.reader(source, delimiter=delimiter, strict=True)
        headers = read_header(reader)
        quoted_table = quote_table_name(table_name, schema_qualified)
        quoted_headers = ", ".join(quote_identifier(header) for header in headers)

        output.write(f"CREATE TABLE {quoted_table} (\n")
        output.write(",\n".join(f"    {quote_identifier(header)} NVARCHAR(MAX) NULL" for header in headers))
        output.write("\n);\n")

        for record_number, row in enumerate(reader, start=2):
            if not row:
                continue
            if len(row) != len(headers):
                raise ValueError(
                    f"record {record_number} has {len(row)} fields; expected {len(headers)}"
                )
            values = ", ".join(sql_string(value) for value in row)
            output.write(f"INSERT INTO {quoted_table} ({quoted_headers}) VALUES ({values});\n")


def convert(
    input_path: Path,
    table_name: str,
    output_path: Path | None,
    delimiter: str,
    schema_qualified: bool,
) -> None:
    quote_table_name(table_name, schema_qualified)
    validate_csv(input_path, delimiter)

    if output_path is None:
        write_sql(input_path, table_name, sys.stdout, delimiter, schema_qualified)
        return

    if input_path.resolve() == output_path.resolve():
        raise ValueError("the output file must be different from the input CSV file")

    output_path.parent.mkdir(parents=True, exist_ok=True)
    temporary_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            newline="",
            dir=output_path.parent,
            delete=False,
        ) as output:
            temporary_path = Path(output.name)
            write_sql(input_path, table_name, output, delimiter, schema_qualified)
        os.replace(temporary_path, output_path)
    finally:
        if temporary_path is not None and temporary_path.exists():
            temporary_path.unlink()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Convert a CSV file to SQL Server CREATE TABLE and INSERT statements."
    )
    parser.add_argument("csv_file", type=Path, help="path to the input CSV file")
    parser.add_argument(
        "-t",
        "--table",
        help="SQL table name (schema-qualified names such as dbo.Customers are supported)",
    )
    parser.add_argument("-o", "--output", type=Path, help="write SQL to a file instead of stdout")
    parser.add_argument(
        "-d",
        "--delimiter",
        default=",",
        help="CSV field delimiter (default: comma)",
    )
    args = parser.parse_args()

    if len(args.delimiter) != 1:
        parser.error("--delimiter must be exactly one character")
    table_name = args.table if args.table is not None else args.csv_file.stem
    try:
        convert(args.csv_file, table_name, args.output, args.delimiter, args.table is not None)
    except (OSError, UnicodeError, csv.Error, ValueError) as error:
        parser.error(str(error))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())